{%- liquid
  assign influencer = metaobject
  if influencer == blank
    assign influencer = product.metafields.custom.influencer.value
  endif
-%}

{%- if influencer != blank -%}
  <section class="influencer-section" style="padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px; background: {{ section.settings.bg_color }};">
    <div class="influencer-section__inner page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="influencer-section__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <div class="influencer-card">
        {%- if influencer.image.value != blank -%}
          <a href="{{ influencer.system.url }}">
            <img
            src="{{ influencer.image.value | image_url: width: 400 }}"
            alt="{{ influencer.name.value | escape }}"
            width="200"
            height="200"
            loading="lazy"
          >
          </a>
          
        {%- endif -%}

        <div class="influencer-card__content">
          <h3>{{ influencer.name.value }}</h3>

          {%- if influencer.description != blank -%}
            <div class="influencer-card__description rte">{{ influencer.description | metafield_tag }}</div>
          {%- endif -%}

          {%- if template.name == 'product' and influencer.system.url != blank -%}
            <a class="influencer-card__link" href="{{ influencer.system.url }}">View profile</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <div style="padding:20px;text-align:center;background:#f3f3f3;">
    Influencer section: is product pe influencer metafield set nahi hai (sirf editor mein nazar aata hai).
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Influencer",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recommended by" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 100, "step": 4, "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 100, "step": 4, "default": 40 }
  ],
  "presets": [{ "name": "Influencer" }]
}
{% endschema %}

{% stylesheet %}
.influencer-card { 
  display: flex; gap: 24px; align-items: center;
 }
 .influencer-card__content h3 {
  margin-top: 0px;
 }
.influencer-card img { 
  border-radius: 50%; object-fit: cover;
 }
 .influencer-card__link {
  display: inline-block;
  margin-top: 16px;
  padding: 12px 28px;
  background: #111;
  color: #fff;
  border: 1px solid #111;
  border-radius: 999px;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-decoration: none;
  transition: background 0.2s ease, color 0.2s ease;
}
.influencer-card__link:hover {
  background: transparent;
  color: #111;
}
@media (max-width: 749px) { .influencer-card { flex-direction: column; text-align: center; } }
{% endstylesheet %}