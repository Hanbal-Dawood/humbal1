<section
  class="hero-banner"
  style="
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">

    <div class="hero-banner__wrapper">

      <div
        class="hero-banner__content"
        style="text-align: {{ section.settings.text_alignment }};"
      >

        {% if section.settings.heading != blank %}
          <h1
            style="color: {{ section.settings.text_color }};"
          >
            {{ section.settings.heading }}
          </h1>
        {% endif %}

        {% if section.settings.description != blank %}
          <p
            style="color: {{ section.settings.text_color }};"
          >
            {{ section.settings.description }}
          </p>
        {% endif %}

        {% if section.settings.show_button %}
          <a
            href="{{ section.settings.button_link }}"
            class="hero-btn"
          >
            {{ section.settings.button_text }}
          </a>
        {% endif %}

      </div>

      {% if section.settings.image %}
        <div class="hero-banner__image">
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            alt="{{ section.settings.heading }}"
          >
        </div>
      {% endif %}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Premium Collection"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover premium products."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Show Button",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 10,
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 10,
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}

<style>
.hero-banner__wrapper {
  display: flex;
  align-items: center;
  gap: 50px;
}

.hero-banner__content {
  flex: 1;
}

.hero-banner__content h1 {
  font-size: 56px;
  margin-bottom: 20px;
}

.hero-banner__content p {
  font-size: 18px;
  margin-bottom: 25px;
}

.hero-btn {
  display: inline-block;
  padding: 14px 30px;
  background: black;
  color: white;
  text-decoration: none;
  border-radius: 10px;
}

.hero-banner__image {
  flex: 1;
}

.hero-banner__image img {
  width: 100%;
  display: block;
}

@media screen and (max-width: 768px) {
  .hero-banner__wrapper {
    flex-direction: column;
  }

  .hero-banner__content h1 {
    font-size: 38px;
  }
}
</style>